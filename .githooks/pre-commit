#!/usr/bin/env bash
# Refuse plaintext secrets and malformed vault files. Enable: git config core.hooksPath .githooks
bad=0
while IFS= read -r f; do
  case "$f" in
    *.vault) head -c 15 "$f" | grep -q '^\$ANSIBLE_VAULT' || { echo "NOT ENCRYPTED: $f"; bad=1; } ;;
    */.env|*/acme.json|*.key|*/telegraf.conf) echo "PLAINTEXT SECRET staged: $f"; bad=1 ;;
  esac
done < <(git diff --cached --name-only --diff-filter=AM)
exit $bad
